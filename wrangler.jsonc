{
"$schema": "node_modules/wrangler/config-schema.json",
"name": "arikepreorder",
"main": "backend/worker.mjs",
"compatibility_date": "2026-11-14",
"compatibility_flags": [
"nodejs_compat",
"nodejs_compat_populate_process_env"
],
"assets": {
"directory": "./backend/public",
"binding": "ASSETS",
"html_handling": "none",
"run_worker_first": true
},
"keep_vars": true,
"vars": {"ARIKE_FROM_EMAIL": "noreply@arikepreorder.site"},
"observability": {
"enabled": true
}
}
